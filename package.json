{
  "name": "autoscend",
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "packages/shared",
    "packages/kolmafia",
    "packages/relay",
    "packages/browser"
  ],
  "resolutions": {
    "kolmafia": "5.29154.0",
    "libram": "0.11.23",
    "grimoire-kolmafia": "^0.3.33"
  },
  "scripts": {
    "lint:settings": "node eslint-rules/scripts/lint-settings-yml.mjs",
    "generate:properties": "node eslint-rules/scripts/generate-property-declarations.mjs",
    "watch:properties": "node eslint-rules/scripts/generate-property-declarations.mjs --watch",
    "typecheck": "yarn generate:properties && tsc -b",
    "bundle": "yarn generate:properties && node esbuild.mjs",
    "build": "node scripts/build.mjs",
    "lint": "yarn generate:properties && yarn lint:settings && eslint packages --cache --cache-location node_modules/.cache/.eslintcache && prettier --check . --cache --cache-location node_modules/.cache/.prettiercache",
    "format": "node scripts/format.mjs"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-libram": "^0.6.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "prettier": "3.9.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "yaml": "^2.9.0"
  }
}
